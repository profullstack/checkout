{
  "name": "@profullstack/checkout",
  "version": "0.1.0",
  "type": "module",
  "description": "One focused checkout page for plans, credit packs and top-ups: prefilled from its link, annual plan preselected, seats, discount code, a value comparison and one button to CoinPay. HTML or React, zero dependencies.",
  "keywords": ["checkout", "pricing", "billing", "credits", "top-up", "coinpay", "crypto", "paypal", "subscription", "react"],
  "repository": { "type": "git", "url": "git+https://github.com/profullstack/checkout.git" },
  "homepage": "https://github.com/profullstack/checkout#readme",
  "bugs": { "url": "https://github.com/profullstack/checkout/issues" },
  "license": "MIT",
  "author": "Profullstack, LLC",
  "exports": {
    ".": { "types": "./index.d.ts", "import": "./src/index.js" },
    "./core": { "types": "./index.d.ts", "import": "./src/core.js" },
    "./react": { "types": "./react.d.ts", "import": "./src/react.js" },
    "./browser": { "types": "./browser.d.ts", "import": "./src/browser.js" },
    "./coinpay": { "types": "./index.d.ts", "import": "./src/coinpay.js" },
    "./checkout.css": "./checkout.css",
    "./package.json": "./package.json"
  },
  "main": "./src/index.js",
  "types": "./index.d.ts",
  "files": ["src", "checkout.css", "index.d.ts", "react.d.ts", "browser.d.ts", "README.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "sideEffects": ["./src/browser.js", "./src/react-client.js", "./checkout.css"],
  "publishConfig": { "access": "public" },
  "peerDependencies": { "react": ">=18" },
  "peerDependenciesMeta": { "react": { "optional": true } },
  "devDependencies": { "react": "^19.0.0", "react-dom": "^19.0.0" },
  "scripts": { "css": "node scripts/sync-css.js", "test": "node --test", "prepublishOnly": "node scripts/sync-css.js && node --test" }
}
